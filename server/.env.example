NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173
MONGODB_URI=mongodb://127.0.0.1:27017/tms_db
JWT_SECRET=supersecret_tms_jwt_key_development_only_change_in_production
JWT_EXPIRES_IN=1d

# Email settings (Ethereal test account or console fallback)
EMAIL_SERVICE=ethereal
EMAIL_HOST=smtp.ethereal.email
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM="Tourism Management System" <no-reply@tms.test>

# SMS service (console log mode by default)
SMS_PROVIDER=mock

# External provider simulation
SIMULATE_PROVIDER_FAILURE=false
